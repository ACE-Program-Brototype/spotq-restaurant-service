generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  PENDING
  COMPLETED
}

model Restaurant {
  id String @id @default(uuid()) @db.Uuid

  restaurantName String @map("restaurant_name")
  email          String @unique
  phone          String

  ownerName  String @map("owner_name")
  ownerEmail String @map("owner_email")

  status           RestaurantStatus @default(PENDING) @map("status")
  onboardingStatus OnboardingStatus @default(PENDING) @map("onboarding_status")

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  rejectionReason String? @map("rejection_reason")

  // Subscription Caching (Updated via BullMQ subscription events)
  isSubscriptionActive Boolean   @default(false) @map("is_subscription_active")
  subscriptionPlanCode String?   @map("subscription_plan_code")
  subscriptionEndsAt   DateTime? @map("subscription_ends_at") @db.Timestamptz(3)

  isBlocked   Boolean @default(false) @map("is_blocked")
  blockReason String? @map("block_reason")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff          RestaurantStaff[]
  invitations    StaffInvitation[]
  profile        RestaurantProfile?
  settings       RestaurantSettings?
  operatingHours RestaurantOperatingHours[]
  address        RestaurantAddress?
  documents      RestaurantDocument[]
  images         RestaurantImage[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  addons         Addon[]

  @@map("restaurants")
}

enum StaffRole {
  STAFF
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
  REMOVED
}

model RestaurantStaff {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  fullname        String      @map("fullname")
  email           String      @map("email")
  phone           String      @map("phone")
  avatarUpdatedAt DateTime?   @map("avatar_updated_at") @db.Timestamptz(3)
  passwordHash    String      @map("password_hash")
  role            StaffRole   @default(STAFF)
  status          StaffStatus @default(ACTIVE)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([email])
  @@map("restaurant_staff")
}

model RestaurantSettings {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @unique @map("restaurant_id") @db.Uuid

  isOpened        Boolean @default(false) @map("is_opened")
  isPreorder      Boolean @default(false) @map("is_preorder")
  acceptsQueue    Boolean @default(true) @map("accepts_queue")
  acceptsQrOrders Boolean @default(true) @map("accepts_qr_orders")
  loyaltyEnabled  Boolean @default(false) @map("loyalty_enabled")
  autoAcceptQueue Boolean @default(false) @map("auto_accept_queue")

  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)

  isLoyaltyEnabled Boolean @default(false) @map("is_loyalty")

  cuisineType     String? @map("cuisine_type")
  seatingCapacity Int?    @map("seating_capacity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model RestaurantProfile {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @unique @map("restaurant_id") @db.Uuid

  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)
  coverImageKey   String?   @map("cover_image_key")
  description     String?   @map("description")
  cuisineType     String?   @map("cuisine_type")
  averageCost     Int?      @default(0) @map("average_cost")
  fssaiNumber     String?   @map("fssai_number")
  registerNumber  String?   @map("register_number")
  gstNumber       String?   @map("gst_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_profile")
}

model RestaurantOperatingHours {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  dayOfWeek    Int       @map("day_of_week")
  isOpen       Boolean   @default(false) @map("is_open")
  isClosed     Boolean   @default(false) @map("is_closed")
  openTime     DateTime? @map("open_time") @db.Time(0)
  closeTime    DateTime? @map("close_time") @db.Time(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("restaurant_operating_hours")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model StaffInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  email        String           @map("email")
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(PENDING) @map("status")
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([email])
  @@index([status])
  @@map("staff_invitations")
}

model ProcessedEvent {
  id          String   @id
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}

model RestaurantAddress {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @unique @map("restaurant_id") @db.Uuid
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String   @map("city")
  state        String   @map("state")
  country      String   @map("country")
  pincode      String   @map("pincode")
  latitude     Decimal  @map("latitude") @db.Decimal(10, 8)
  longitude    Decimal  @map("longitude") @db.Decimal(11, 8)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_addresses")
}

enum DocumentType {
  FSSAI
  BUSINESS_REGISTRATION
  OWNER_IDENTITY
  GST
  BUSINESS_PAN
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model RestaurantDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  restaurantId       String                     @map("restaurant_id") @db.Uuid
  documentType       DocumentType               @map("document_type")
  documentName       String                     @map("document_name")
  documentKey        String                     @map("document_key")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  uploadedAt         DateTime                   @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_documents")
}

model RestaurantImage {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  objectKey    String   @map("object_key")
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_images")
}

model MenuCategory {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid

  name         String  @db.VarChar(255)
  description  String?
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, displayOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  categoryId   String @map("category_id") @db.Uuid

  name            String  @db.VarChar(255)
  description     String?
  price           Decimal @db.Decimal(10, 2)
  preparationTime Int?    @map("preparation_time")
  calories        Int?

  isVegetarian Boolean @default(false) @map("is_vegetarian")
  isFeatured   Boolean @default(false) @map("is_featured")
  isAvailable  Boolean @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images   MenuItemImage[]
  variants MenuItemVariant[]
  addons   MenuItemAddon[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemImage {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  objectKey    String   @map("object_key") @db.VarChar(500)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
  @@map("menu_item_images")
}

model MenuItemVariant {
  id         String  @id @default(uuid()) @db.Uuid
  menuItemId String  @map("menu_item_id") @db.Uuid
  sku        String? @db.VarChar(100)
  name       String  @db.VarChar(255)
  price      Decimal @db.Decimal(10, 2)
  isDefault  Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model Addon {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  name         String  @db.VarChar(255)
  description  String?
  price        Decimal @db.Decimal(10, 2)
  imageKey     String? @map("image_key") @db.VarChar(500)
  isAvailable  Boolean @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItemAddon[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("addons")
}

model MenuItemAddon {
  id            String   @id @default(uuid()) @db.Uuid
  menuItemId    String   @map("menu_item_id") @db.Uuid
  addonId       String   @map("addon_id") @db.Uuid
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  displayOrder  Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addon    Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addonId])
  @@index([menuItemId])
  @@index([addonId])
  @@map("menu_item_addons")
}
