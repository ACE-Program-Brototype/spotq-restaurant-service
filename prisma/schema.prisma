generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id               String           @id @default(uuid()) @db.Uuid

  restaurantName   String
  email            String           @unique
  phone            String

  ownerName        String
  ownerEmail       String

  seatingCapacity  Int?
  fssaiNumber      String?
  gstNumber        String?
  regNumber        String?

  cuisineType      String?

  status           RestaurantStatus @default(PENDING)

  emailVerifiedAt  DateTime?

  isBlocked        Boolean          @default(false)
  blockReason      String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("restaurants")
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
}