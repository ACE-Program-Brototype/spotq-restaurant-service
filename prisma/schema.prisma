generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  PENDING
  COMPLETED
}

model Restaurant {
  id String @id @default(uuid()) @db.Uuid

  restaurantName String
  email          String @unique
  phone          String

  ownerName  String
  ownerEmail String

  status           RestaurantStatus @default(PENDING)
  onboardingStatus OnboardingStatus @default(PENDING)

  emailVerifiedAt DateTime?

  isBlocked   Boolean @default(false)
  blockReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff    RestaurantStaff[]
  profile  RestaurantProfile?
  settings RestaurantSettings?

  @@map("restaurants")
}

enum StaffRole {
  STAFF
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

model RestaurantStaff {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  fullname     String      @map("fullname")
  email        String      @unique @map("email")
  phone        String      @map("phone")
  avatarUrl    String?     @map("avatar_url")
  passwordHash String      @map("password_hash")
  role         StaffRole   @default(STAFF)
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([email])
  @@map("restaurant_staff")
}

model RestaurantSettings {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @unique @map("restaurant_id") @db.Uuid

  isOpened   Boolean @default(false) @map("is_opened")
  isPreorder Boolean @default(false) @map("is_preorder")

  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)

  isSunday  Boolean @default(false) @map("is_sunday")
  isLoyalty Boolean @default(false) @map("is_loyalty")

  cuisineType     String? @map("cuisine_type")
  seatingCapacity Int?    @map("seating_capacity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model RestaurantProfile {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @unique @map("restaurant_id") @db.Uuid

  coverImage     String? @map("cover_image")
  avatar         String?
  description    String?
  licenceNumber  String? @map("licence_number")
  registerNumber String? @map("register_number")
  gstNumber      String? @map("gst_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_profile")
}
