# Server Configuration
PORT=3000
APP_ENV=development
LOG_LEVEL=info

# Database & Cache
DATABASE_URL=postgresql://user:password@localhost:5432/spotq_restaurant_db?schema=public
REDIS_URL=redis://localhost:6379

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=spotq-restaurant-bucket

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@spotq.com
BREVO_SENDER_NAME=SpotQ

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# JWT Configuration
JWT_ACCESS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_KEY_ID=spotq-restaurant-auth-key-1
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_64_chars_long_random_string_here
JWT_REFRESH_EXPIRES_IN=7d
JWT_TEMP_SECRET=your_jwt_temp_secret_key_min_8_chars
JWT_TEMP_EXPIRES_IN=15m

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Cookie Configuration
COOKIE_NAME_REFRESH_TOKEN=refreshToken
COOKIE_NAME_TEMP_TOKEN=tempToken
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_PATH=/
COOKIE_MAX_AGE_MS=604800000
COOKIE_TEMP_TOKEN_MAX_AGE_MS=900000
# COOKIE_DOMAIN=localhost

# Frontend Invitation Configuration
FRONTEND_URL=http://localhost:3000
INVITATION_ACCEPT_PATH=/invitations/accept
INVITATION_TOKEN_TTL_HOURS=48

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_FORGOT_PASSWORD_MAX_ATTEMPTS=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=86400
RATE_LIMIT_VERIFY_OTP_MAX_ATTEMPTS=5
RATE_LIMIT_VERIFY_OTP_WINDOW_SECONDS=900
RATE_LIMIT_RESEND_OTP_MAX_ATTEMPTS=3
RATE_LIMIT_RESEND_OTP_WINDOW_SECONDS=3600
RATE_LIMIT_RESET_PASSWORD_MAX_ATTEMPTS=5
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_TOKEN_MAX_ATTEMPTS=30
RATE_LIMIT_REFRESH_TOKEN_WINDOW_SECONDS=60
RATE_LIMIT_INVITE_STAFF_MAX_ATTEMPTS=10
RATE_LIMIT_INVITE_STAFF_WINDOW_SECONDS=3600
RATE_LIMIT_REVOKE_INVITATION_MAX_ATTEMPTS=30
RATE_LIMIT_REVOKE_INVITATION_WINDOW_SECONDS=900
RATE_LIMIT_VALIDATE_INVITATION_MAX_ATTEMPTS=30
RATE_LIMIT_VALIDATE_INVITATION_WINDOW_SECONDS=900
RATE_LIMIT_ACCEPT_INVITATION_MAX_ATTEMPTS=10
RATE_LIMIT_ACCEPT_INVITATION_WINDOW_SECONDS=900

# Seeding Variables (Optional)
# RESTAURANT_ID=your-restaurant-uuid-here
# SAMPLE_STAFF_PASSWORD=Password@123

