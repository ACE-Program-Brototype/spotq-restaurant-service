{
	"name": "spotq-restaurant-service",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"test": "jest --passWithNoTests --forceExit",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage --forceExit",
		"dev": "tsx watch src/server.ts",
		"dev:infisical": "infisical run --env=dev -- pnpm dev",
		"build": "tsup",
		"start": "node dist/server.js",
		"lint": "biome lint --error-on-warnings .",
		"format": "biome format --write .",
		"check": "biome check --error-on-warnings --write .",
		"seed:staff": "tsx prisma/seed.ts",
		"validate": "pnpm lint && pnpm build",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.18.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1112.0",
		"@getbrevo/brevo": "^6.0.3",
		"@prisma/client": "^6.19.3",
		"bcrypt": "^6.0.0",
		"bullmq": "^6.0.6",
		"cookie-parser": "^1.4.7",
		"express": "^5.2.1",
		"inversify": "^8.2.3",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@jest/globals": "^29.7.0",
		"@swc/core": "^1.16.1",
		"@swc/jest": "^0.2.39",
		"@types/cookie-parser": "^1.4.10",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.2",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"prisma": "^6.19.3",
		"tsc-alias": "^1.9.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
