# Server Configuration
PORT=3000
APP_ENV=development
LOG_LEVEL=info

# Database & Cache
DATABASE_URL=postgresql://user:password@localhost:5432/spotq_restaurant_db?schema=public
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_8_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_8_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_TEMP_SECRET=your_jwt_temp_secret_key_min_8_chars
JWT_TEMP_EXPIRES_IN=15m

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@spotq.com
BREVO_SENDER_NAME=SpotQ

# Cookie Configuration
COOKIE_NAME_REFRESH_TOKEN=refreshToken
COOKIE_NAME_TEMP_TOKEN=tempToken
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_PATH=/
COOKIE_MAX_AGE_MS=604800000
# COOKIE_DOMAIN=localhost

# Seeding Variables (Optional)
# RESTAURANT_ID=your-restaurant-uuid-here
# SAMPLE_STAFF_PASSWORD=Password@123